{
  "name": "hubnx-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "vite build --configLoader runner && vite build --configLoader runner -c electron/vite.config.ts --mode main && vite build --configLoader runner -c electron/vite.config.ts --mode preload && vite build --configLoader runner -c electron/vite.config.ts --mode transcribe && vite build --configLoader runner -c electron/vite.config.ts --mode denoise && node scripts/app-notices.ts",
    "dev": "pnpm build && node scripts/start.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe": "node scripts/probe-webcodecs.ts",
    "ffmpeg": "node scripts/fetch-ffmpeg.ts",
    "package": "node scripts/package.ts",
    "check-package": "node scripts/check-package.ts"
  },
  "devDependencies": {
    "@hubnx/web-parts": "github:hubnx/web-parts#f84f4afe29743e85e0c01c7110ec11a4e565289d",
    "@types/node": "26.6.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "immer": "11.2.9",
    "mediabunny": "1.65.2",
    "sherpa-onnx-node": "2.0.1"
  }
}
