{
  "name": "hubnx-video",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "vite build && vite build -c electron/vite.config.ts --mode main && vite build -c electron/vite.config.ts --mode preload",
    "dev": "pnpm build && node scripts/start.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "probe": "node scripts/probe-webcodecs.ts",
    "ffmpeg": "node scripts/fetch-ffmpeg.ts",
    "package": "node scripts/package.ts",
    "check-package": "node scripts/check-package.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "immer": "11.2.9",
    "mediabunny": "1.65.2"
  }
}
