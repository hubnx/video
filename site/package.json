{
  "name": "video-site",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite --configLoader runner --port 4162 --strictPort",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --port 4163 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screens": "node scripts/screens.ts"
  },
  "dependencies": {
    "@hubnx/web-parts": "github:hubnx/web-parts#f84f4afe29743e85e0c01c7110ec11a4e565289d",
    "modern-screenshot": "4.7.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
